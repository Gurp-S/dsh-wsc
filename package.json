{
  "name": "@xeyo/wsc-deepseek-harness",
  "version": "0.1.0",
  "description": "Deterministic XEYO WSC compaction backend for DeepSeek Harness 0.1.1-rc.2",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/history.js",
    "lib/settings.js",
    "lib/types/**/*.d.ts",
    "python/**/*.py",
    "preset/**/*.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_LICENSES.md"
  ],
  "engines": {
    "node": ">=20",
    "python": ">=3.11"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-compaction-basic": "0.1.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-loader": "1.0.2",
    "@deepseek-ai/dsh-compaction-basic": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2"
  },
  "scripts": {
    "test": "node --test",
    "test:python": "py -3.11 -m unittest discover -s python/tests -p 'test_*.py'"
  },
  "license": "MIT"
}
